---
interface Props {
  title: string;
  description?: string;
}
import { canonicalUrl, nuIndexa } from "../lib/format";

const { title, description } = Astro.props;

const CATS = ["Politică", "Economie", "Social", "Justiție", "Externe", "Sport", "Cultură"];
const url = Astro.url;
const curCat = url.searchParams.get("cat");
const curQ = url.searchParams.get("q") ?? "";
const onHome = url.pathname === "/";
const homeActive = onHome && !curCat && !curQ;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl(url, Astro.site ?? url.origin)} />
    {nuIndexa(url) && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <style is:global>
      :root {
        --paper: #fbfaf7;
        --ink: #06001a;
        --muted: #736e7e;
        --hairline: #e6e2d9;
        --accent: #c8102e;
        --maxw: 660px;
        --serif: Georgia, 'Iowan Old Style', 'Times New Roman', Times, serif;
        --sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { color-scheme: light; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 660px; margin: 0 auto; padding: 0 20px; }
      .container-larg { max-width: 1080px; }

      /* Masthead */
      .masthead { text-align: center; padding: 46px 0 0; }
      .masthead .brand {
        display: inline-block;
        font-family: var(--serif);
        font-size: 40px;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
      }
      .brand-dot { color: var(--accent); }
      .tagline {
        margin: 10px 0 0;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--muted);
      }
      .nav { margin-top: 26px; border-top: 1px solid var(--hairline); border-bottom: 2px solid var(--ink); }
      .nav-in {
        display: flex; justify-content: center; flex-wrap: wrap;
        gap: 4px 22px; padding-top: 12px; padding-bottom: 14px;
      }
      .nav a {
        font-size: 12px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.12em; color: var(--muted); transition: color 0.15s;
      }
      .nav a:hover { color: var(--ink); }
      .nav a.active { color: var(--accent); }

      /* Stripă de actualizare */
      .updated {
        text-align: center; font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.14em; color: var(--muted); padding: 22px 0 4px;
      }
      .updated::before {
        content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%;
        background: #22a06b; margin-right: 9px; vertical-align: 1px;
        animation: pulse 2.4s ease-in-out infinite;
      }
      @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

      /* Șirea principală (lead) */
      .lead { display: block; padding: 30px 0; border-bottom: 1px solid var(--hairline); }
      .kicker {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.18em; color: var(--accent);
      }
      .lead-title {
        margin: 10px 0 12px; font-family: var(--serif); font-size: 31px;
        line-height: 1.16; font-weight: 700; letter-spacing: -0.01em;
      }
      .lead:hover .lead-title { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
      .lead-sum { margin: 0 0 14px; color: var(--muted); font-size: 15px; line-height: 1.55; }

      /* Rânduri de articole */
      .art { display: block; padding: 20px 0; border-bottom: 1px solid var(--hairline); }
      .art-title {
        margin: 0; font-family: var(--serif); font-size: 19.5px;
        line-height: 1.26; font-weight: 700; letter-spacing: -0.005em;
      }
      .art:hover .art-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .art-sum {
        margin: 7px 0 0; color: var(--muted); font-size: 13.5px; line-height: 1.5;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .art-meta {
        display: flex; justify-content: space-between; align-items: baseline;
        gap: 14px; margin-top: 8px; font-size: 12px; color: var(--muted);
      }
      .art-left { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
      .theme {
        font-size: 10.5px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.14em; color: var(--ink); white-space: nowrap;
      }
      .art-src { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .surse-n { color: var(--accent); white-space: nowrap; }

      /* Căutare */
      .cauta { display: flex; justify-content: center; gap: 8px; margin: 16px auto 0; max-width: 420px; }
      .cauta input {
        flex: 1; min-width: 0; font: inherit; font-size: 14px; padding: 8px 14px;
        border: 1px solid var(--hairline); border-radius: 999px; background: #fff;
        color: var(--ink); outline: none;
      }
      .cauta input:focus { border-color: var(--ink); }
      .cauta button {
        font: inherit; font-size: 13px; font-weight: 700; padding: 8px 18px;
        border: 1px solid var(--ink); border-radius: 999px; background: var(--ink);
        color: #fff; cursor: pointer;
      }
      .cauta button:hover { background: #2a2440; }
      mark { background: #ffe89a; color: inherit; padding: 0 2px; }

      /* Secțiuni */
      .section { margin-top: 44px; }
      .sec-head {
        display: flex; align-items: baseline; justify-content: space-between;
        border-top: 2px solid var(--ink); padding-top: 10px; margin-bottom: 4px;
      }
      .sec-head h2 {
        margin: 0; font-family: var(--sans); font-size: 14px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.18em;
      }

      /* Antet pagină de secțiune */
      .page-head { margin-top: 40px; border-top: 2px solid var(--ink); padding-top: 14px; }
      .page-head h1 {
        margin: 0; font-family: var(--serif); font-size: 30px; font-weight: 700;
        letter-spacing: -0.01em; line-height: 1.1;
      }
      .page-head p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
      .page-head .kicker { display: block; margin-bottom: 10px; }
      .page-head .clear { color: var(--accent); font-weight: 700; }

      /* Pagina de citire */
      .reader { padding-top: 34px; }
      .reader-back {
        display: inline-block; font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.16em; color: var(--muted); margin-bottom: 26px;
      }
      .reader-back:hover { color: var(--ink); }
      .reader .kicker { display: block; text-align: center; }
      .reader-title {
        margin: 14px auto 18px; font-family: var(--serif); font-size: 30px;
        line-height: 1.18; font-weight: 700; letter-spacing: -0.01em; text-align: center; max-width: 560px;
      }
      .reader-meta {
        display: flex; justify-content: space-between; align-items: baseline;
        gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--muted);
        border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);
        padding: 10px 0; margin-bottom: 30px;
      }
      .ai-tag {
        font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
        color: var(--accent); border: 1px solid var(--accent); border-radius: 999px;
        padding: 1px 8px; white-space: nowrap;
      }
      .reader-body p { margin: 0 0 18px; font-family: var(--serif); font-size: 17px; line-height: 1.7; }
      .reader-legal { margin: 26px 0 0; font-size: 11.5px; color: var(--muted); opacity: 0.75; text-align: center; }

      /* Sursele subiectului */
      .surse { margin-top: 44px; }
      .sursa {
        display: flex; justify-content: space-between; align-items: baseline;
        gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--hairline);
      }
      .sursa-title { font-size: 14.5px; line-height: 1.4; color: var(--muted); transition: color 0.15s; }
      .sursa:hover .sursa-title { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
      .sursa-meta { font-size: 12px; color: var(--muted); white-space: nowrap; }

      /* Gol */
      .gol { padding: 34px 0; color: var(--muted); font-size: 14px; border-bottom: 1px solid var(--hairline); }

      /* Footer */
      .footer { margin-top: 64px; border-top: 2px solid var(--ink); padding: 26px 0 60px; }
      .footer-brand { font-family: var(--serif); font-weight: 700; font-size: 17px; margin: 0 0 10px; text-align: center; }
      .footer-text { margin: 0 auto 14px; font-size: 12.5px; line-height: 1.65; color: var(--muted); text-align: center; max-width: 480px; }
      .footer-sources { font-size: 11px; color: var(--muted); text-align: center; letter-spacing: 0.04em; line-height: 1.8; opacity: 0.75; }

      /* Panou „Cele mai populare” */
      /* Coloana de stiri are exact latimea paginii de citire (660px), ca textul sa nu
         isi schimbe latimea cand deschizi o stire. `minmax` o lasa sa se stranga pe
         ecrane mai inguste, iar `justify-content` centreaza perechea de coloane. */
      .home-grid {
        display: grid;
        /* 620px = 660px (max-width .container) minus 2×20px padding, adica exact
           latimea textului din pagina de citire. */
        grid-template-columns: minmax(0, 620px) 300px;
        gap: 48px;
        align-items: start;
        justify-content: center;
      }
      .panou-popular { border-top: 2px solid var(--ink); padding-top: 10px; position: sticky; top: 24px; }
      .panou-popular h2 {
        margin: 0; font-family: var(--sans); font-size: 14px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.18em;
      }
      .taburi { display: flex; gap: 6px; margin: 12px 0 6px; }
      .tab {
        font: inherit; font-size: 12px; font-weight: 700; padding: 4px 12px;
        border: 1px solid var(--hairline); border-radius: 999px; background: transparent;
        color: var(--muted); cursor: pointer; user-select: none;
      }
      .tab:hover { border-color: var(--muted); }
      .tab.activ { background: var(--ink); border-color: var(--ink); color: #fff; }
      .popular-lista { list-style: none; margin: 0; padding: 0; }
      .popular-lista li { border-bottom: 1px solid var(--hairline); }
      .popular-lista a { display: flex; gap: 12px; padding: 11px 0; }
      .popular-lista a:hover .pop-titlu { text-decoration: underline; text-underline-offset: 3px; }
      .pop-rank {
        font-family: var(--serif); font-size: 19px; font-weight: 700;
        color: var(--accent); min-width: 20px; line-height: 1.2;
      }
      .pop-corp { flex: 1; min-width: 0; }
      .pop-titlu { display: block; font-size: 13.5px; line-height: 1.4; }
      .pop-meta { display: block; font-size: 11.5px; color: var(--muted); margin-top: 3px; }
      .pop-gol { color: var(--muted); font-size: 13px; padding: 12px 0; }

      /* Taburi fara JavaScript (radio + label) */
      .pop-radio { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }
      .pop-panou-lista { display: none; }
      #pop-48:checked ~ .lista-48,
      #pop-7:checked ~ .lista-7,
      #pop-30:checked ~ .lista-30 { display: block; }
      #pop-48:checked ~ .taburi label[for="pop-48"],
      #pop-7:checked ~ .taburi label[for="pop-7"],
      #pop-30:checked ~ .taburi label[for="pop-30"] {
        background: var(--ink); border-color: var(--ink); color: #fff;
      }

      /* Pe ecrane late, coloana de stiri se aseaza EXACT ca pagina de citire: o
         coloana goala, egala cu panoul, echilibreaza dreapta, deci fluxul ramane
         centrat in fereastra. Nevoie de 620 + 2×(48+300) + 40 = 1356px. */
      @media (min-width: 1360px) {
        .container-larg { max-width: 1356px; }
        .home-grid { grid-template-columns: 300px minmax(0, 620px) 300px; }
        .flux { grid-column: 2; }
        .panou-popular { grid-column: 3; }
      }

      @media (max-width: 1000px) {
        .home-grid { grid-template-columns: 1fr; gap: 0; }
        .panou-popular { position: static; margin-top: 44px; }
        .flux, .panou-popular { grid-column: auto; }
      }

      /* Responsiv */
      @media (max-width: 620px) {
        .masthead { padding-top: 34px; }
        .masthead .brand { font-size: 32px; }
        .lead-title { font-size: 25px; }
        .page-head h1 { font-size: 26px; }
        .nav-in { gap: 2px 16px; }
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <div class="container">
        <a class="brand" href="/">Știri<span class="brand-dot">.</span></a>
        <p class="tagline">Din presa Republicii Moldova</p>
        <form class="cauta" action="/" method="get" role="search">
          <input type="search" name="q" value={curQ} placeholder="caută în știri…" aria-label="Caută în știri" />
          <button type="submit">caută</button>
        </form>
      </div>
      <nav class="nav"><div class="nav-in">
        <a href="/" class={homeActive ? "active" : ""}>Acasă</a>
        {CATS.map((c) => (
          <a href={`/?cat=${encodeURIComponent(c)}`} class={c === curCat ? "active" : ""}>{c}</a>
        ))}
      </div></nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <p class="footer-brand">Știri.</p>
        <p class="footer-text">Rezumate generate automat din mai multe surse. Verificați întotdeauna sursele originale.</p>
        <p class="footer-sources">Ziarul de Gardă · TV8 · NewsMaker · Unimedia · Deschide.md · IPN · Moldova1</p>
      </div>
    </footer>
  </body>
</html>
