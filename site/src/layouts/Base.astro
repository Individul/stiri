---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #666;
        --border: #e6e6e6;
        --accent: #1256b8;
        --accent-bg: #eef3fb;
        --card-hover: #fafafa;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16181c;
          --fg: #e8e8ea;
          --muted: #9aa0a8;
          --border: #2a2e35;
          --accent: #7fb0ff;
          --accent-bg: #1d2530;
          --card-hover: #1b1e24;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
      }
      a {
        color: var(--accent);
      }
      .site-head {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      .site-head h1 {
        font-size: 1.35rem;
        margin: 0;
        letter-spacing: -0.01em;
      }
      .site-head a {
        color: inherit;
        text-decoration: none;
      }
      .site-head .tagline {
        color: var(--muted);
        font-size: 0.85rem;
      }
      .badge {
        display: inline-block;
        font-size: 0.78rem;
        color: var(--muted);
        white-space: nowrap;
      }
      .cat {
        display: inline-block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent);
        background: var(--accent-bg);
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
      }
      footer.site-foot {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <a href="/"><h1>Știri</h1></a>
        <span class="tagline">agregate din surse românești</span>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">
        Rezumate generate automat din mai multe surse. Verificați întotdeauna sursele originale.
      </footer>
    </div>
  </body>
</html>
