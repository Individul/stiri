---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

const CATS = ["Politică", "Economie", "Social", "Justiție", "Externe", "Sport", "Cultură"];
const url = Astro.url;
const curCat = url.searchParams.get("cat");
const curQ = url.searchParams.get("q") ?? "";
const onHome = url.pathname === "/";
const homeActive = onHome && !curCat && !curQ;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #fbfaf7;          /* alb-crem curat, nu galben */
        --fg: #16131d;
        --muted: #736e7e;
        --border: #e7e4dd;
        --border-strong: #cfcabf;
        --accent: #c1121f;      /* rosu de tipar */
        /* Titluri: serif de sistem. Text: sans de sistem (lizibil). */
        --font-display: Georgia, "Iowan Old Style", "Times New Roman", Times, serif;
        --font-body: "Helvetica Neue", Helvetica, Arial, system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17161a;
          --fg: #ececee;
          --muted: #9a95a3;
          --border: #2b2930;
          --border-strong: #3a3742;
          --accent: #ff6b6f;
        }
      }
      * { box-sizing: border-box; }
      html { color-scheme: light dark; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 660px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
      a { color: var(--accent); }
      h1, h2, h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.3px; }

      .site-head {
        text-align: center;
        padding: 1.2rem 0 0;
      }
      .site-head .brand { color: inherit; text-decoration: none; }
      .site-head h1 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 2.5rem;
        line-height: 1;
        margin: 0;
      }
      .site-head h1 .dot { color: var(--accent); }
      .site-head .tagline {
        display: block;
        margin-top: .55rem;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: var(--muted);
      }
      /* Cautare */
      .search {
        display: flex;
        gap: .5rem;
        max-width: 520px;
        margin: 1.1rem auto 0;
      }
      .search input {
        flex: 1;
        font: inherit;
        font-size: .95rem;
        padding: .6rem .9rem;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        outline: none;
      }
      .search input::placeholder { color: var(--muted); }
      .search input:focus { border-color: var(--accent); }
      .search button {
        font: inherit;
        font-weight: 600;
        font-size: .9rem;
        padding: .6rem 1.3rem;
        color: #fff;
        background: #1a1622;
        border: none;
        border-radius: 999px;
        cursor: pointer;
      }
      @media (prefers-color-scheme: dark) {
        .search button { background: #e9e7ec; color: #17161a; }
      }
      /* Navigare categorii */
      .mainnav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .3rem 1.3rem;
        margin-top: 1.1rem;
        padding: .9rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 2px solid var(--fg);
      }
      .mainnav a {
        font-size: .74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .09em;
        color: var(--muted);
        text-decoration: none;
      }
      .mainnav a:hover { color: var(--fg); }
      .mainnav a.active { color: var(--accent); }

      .badge {
        display: inline-block;
        font-size: .82rem;
        font-weight: 600;
        color: var(--accent);
        white-space: nowrap;
      }
      .cat {
        display: inline-block;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--accent);
      }
      footer.site-foot {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: .8rem;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href="/"><h1>Știri<span class="dot">.</span></h1></a>
        <span class="tagline">Din presa Republicii Moldova · actualizat automat</span>
        <form class="search" action="/" method="get" role="search">
          <input type="search" name="q" value={curQ} placeholder="caută în știri…" aria-label="Caută în știri" />
          <button type="submit">caută</button>
        </form>
        <nav class="mainnav" aria-label="Categorii">
          <a href="/" class={homeActive ? "active" : ""}>Acasă</a>
          {CATS.map((c) => (
            <a href={`/?cat=${encodeURIComponent(c)}`} class={c === curCat ? "active" : ""}>{c}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">
        Rezumate generate automat din mai multe surse. Verificați întotdeauna sursele originale.
      </footer>
    </div>
  </body>
</html>
