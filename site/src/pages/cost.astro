---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import {
  usageBreakdown, usageSince, usageTotalSince,
  USD_PER_NEURON, FREE_NEURONS_PER_DAY, type DayUsage, type UsageRow,
} from "../lib/db";

const { DB } = env;
const today = new Date().toISOString().slice(0, 10);
const monthStart = today.slice(0, 8) + "01";

const breakdown: UsageRow[] = await usageBreakdown(DB, today);
const days: DayUsage[] = await usageSince(DB, monthStart);
const monthTotal = await usageTotalSince(DB, today.slice(0, 7) + "-01");

// Cost facturabil = doar Neuronii peste alocatia gratuita de 10.000/zi, insumati pe zile.
const billableForDay = (n: number) => Math.max(0, n - FREE_NEURONS_PER_DAY);
const monthBillable = days.reduce((s, d) => s + billableForDay(d.neurons), 0);
const todayRow = days.find((d) => d.day === today);
const todayNeurons = todayRow?.neurons ?? 0;
const todayCalls = todayRow?.calls ?? 0;

const usd = (neurons: number) => (neurons * USD_PER_NEURON).toFixed(2);

// Proiectie lunara pe media zilnica masurata. Alocatia gratuita e ZILNICA,
// deci se scade din fiecare zi, nu o singura data pe luna.
const zileCuDate = days.length;
const medieZi = zileCuDate ? days.reduce((s, d) => s + d.neurons, 0) / zileCuDate : 0;
const proiectieLunara = 30 * billableForDay(medieZi) * USD_PER_NEURON;
const ABONAMENT = 5;
const stepLabel: Record<string, string> = {
  embed: "Embeddings (bge-m3)", confirm: "Confirmare dedup", summarize: "Rezumat",
};
---

<Base title="Costuri Workers AI — Știri">
  <div class="container">
  <a class="back" href="/">← Toate știrile</a>
  <h1>Costuri Workers AI</h1>
  <p class="note">
    Cost Cloudflare: <strong>$0.011 / 1.000 Neuroni</strong>, primii
    <strong>10.000 Neuroni/zi gratis</strong>. Sumele de mai jos numără doar consumul
    peste alocația gratuită (cost estimat, nu factura oficială).
  </p>

  <div class="cards">
    <div class="stat">
      <div class="stat-label">Azi ({today})</div>
      <div class="stat-big">{Math.round(todayNeurons).toLocaleString("ro-RO")} <span>Neuroni</span></div>
      <div class="stat-sub">{todayCalls.toLocaleString("ro-RO")} apeluri · cost estimat <strong>${usd(billableForDay(todayNeurons))}</strong></div>
      <div class="stat-sub">{todayNeurons <= FREE_NEURONS_PER_DAY ? "în alocația gratuită ✓" : "peste alocația gratuită"}</div>
    </div>
    <div class="stat">
      <div class="stat-label">Luna curentă</div>
      <div class="stat-big">{Math.round(monthTotal.neurons).toLocaleString("ro-RO")} <span>Neuroni</span></div>
      <div class="stat-sub">{monthTotal.calls.toLocaleString("ro-RO")} apeluri · cost estimat <strong>${usd(monthBillable)}</strong></div>
      <div class="stat-sub">consum peste alocația zilnică gratuită</div>
    </div>
    <div class="stat">
      <div class="stat-label">Proiecție lunară</div>
      <div class="stat-big">${(proiectieLunara + ABONAMENT).toFixed(2)}</div>
      <div class="stat-sub">
        ${proiectieLunara.toFixed(2)} Workers AI + ${ABONAMENT.toFixed(2)} abonament Workers Paid
      </div>
      <div class="stat-sub">
        pe media de {Math.round(medieZi).toLocaleString("ro-RO")} Neuroni/zi
        ({zileCuDate} {zileCuDate === 1 ? "zi" : "zile"} măsurate)
      </div>
    </div>
  </div>

  <h2>Defalcare azi, pe pas și model</h2>
  {breakdown.length === 0 ? (
    <p class="empty">Niciun consum înregistrat azi încă. (Metering-ul contorizează de la următoarea rulare a pipeline-ului.)</p>
  ) : (
    <table>
      <thead><tr><th>Pas</th><th>Model</th><th class="r">Apeluri</th><th class="r">Neuroni</th><th class="r">Cost est.</th></tr></thead>
      <tbody>
        {breakdown.map((r) => (
          <tr>
            <td>{stepLabel[r.step] ?? r.step}</td>
            <td class="mono">{r.model.replace("@cf/", "")}</td>
            <td class="r">{r.calls.toLocaleString("ro-RO")}</td>
            <td class="r">{Math.round(r.neurons).toLocaleString("ro-RO")}</td>
            <td class="r">${usd(r.neurons)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Ultimele zile</h2>
  {days.length === 0 ? (
    <p class="empty">Nimic încă.</p>
  ) : (
    <table>
      <thead><tr><th>Zi</th><th class="r">Apeluri</th><th class="r">Neuroni</th><th class="r">Facturabil</th><th class="r">Cost est.</th></tr></thead>
      <tbody>
        {days.map((d) => (
          <tr>
            <td class="mono">{d.day}</td>
            <td class="r">{d.calls.toLocaleString("ro-RO")}</td>
            <td class="r">{Math.round(d.neurons).toLocaleString("ro-RO")}</td>
            <td class="r">{Math.round(billableForDay(d.neurons)).toLocaleString("ro-RO")}</td>
            <td class="r">${usd(billableForDay(d.neurons))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Celelalte servicii Cloudflare</h2>
  <table>
    <thead><tr><th>Serviciu</th><th>Consumul nostru</th><th>Inclus în Workers Paid</th><th class="r">Cost</th></tr></thead>
    <tbody>
      <tr><td>Workers Paid</td><td>abonament de bază</td><td>10M cereri + 30M CPU-ms/lună</td><td class="r">$5.00</td></tr>
      <tr><td>Vectorize</td><td>~18M dimensiuni interogate/lună</td><td>50M interogate + 10M stocate</td><td class="r">$0.00</td></tr>
      <tr><td>Queues</td><td>~150 mii operațiuni/lună</td><td>1M operațiuni/lună</td><td class="r">$0.00</td></tr>
      <tr><td>D1</td><td>sub 1M rânduri scrise/lună</td><td>50M scrise, 25 mld. citite</td><td class="r">$0.00</td></tr>
      <tr><td>Workers KV</td><td>practic nefolosit (sesiuni)</td><td>10M citiri/lună</td><td class="r">$0.00</td></tr>
    </tbody>
  </table>

  <p class="note">
    Prețuri verificate în documentația Cloudflare: Workers AI <strong>10.000 Neuroni/zi gratis</strong>
    (și pe Free, și pe Paid), apoi <strong>$0.011 / 1.000 Neuroni</strong>. Singurul serviciu care
    generează cost peste abonament este Workers AI — restul rămân confortabil în alocațiile incluse.
  </p>
  <p class="note">
    Toți cei trei pași sunt măsurați acum, inclusiv embeddings-urile
    (<code>bge-m3</code> raportează Neuronii în <code>meta</code>, nu în <code>usage</code> ca
    modelele de text — până la 7 septembrie 2026 apăreau cu 0 aici). Cifra oficială de
    facturare o vezi în Cloudflare → AI → Workers AI și în Billing.
  </p>

  <style>
    .back { display: inline-block; font-size: .85rem; text-decoration: none; margin-bottom: 1rem; }
    h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
    h2 { font-size: 1.05rem; margin: 2rem 0 .6rem; }
    .note { color: var(--muted); font-size: .85rem; }
    .cards { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.25rem 0; }
    .stat { flex: 1 1 260px; border: 1px solid var(--hairline); border-radius: 10px; padding: 1rem 1.1rem; }
    .stat-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    .stat-big { font-size: 1.8rem; font-weight: 700; margin: .3rem 0; }
    .stat-big span { font-size: .9rem; font-weight: 400; color: var(--muted); }
    .stat-sub { font-size: .85rem; color: var(--muted); }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    th, td { text-align: left; padding: .45rem .5rem; border-bottom: 1px solid var(--hairline); }
    th.r, td.r { text-align: right; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .82rem; }
    .empty { color: var(--muted); }
  </style>
  </div>
</Base>
