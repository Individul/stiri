---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { topClusters } from "../lib/db";
import { formatSourceCount, rankScore } from "../lib/format";

const { DB } = env;
const category = Astro.url.searchParams.get("cat") ?? undefined;
const q = (Astro.url.searchParams.get("q") ?? "").trim() || undefined;
const filtered = Boolean(q || category);

const cards = (await topClusters(DB, category, q))
  .sort((a, b) => rankScore(b.source_count, b.last_updated_at) - rankScore(a.source_count, a.last_updated_at))
  .slice(0, 50);

const now = new Date().toLocaleDateString("ro-RO", {
  weekday: "long", day: "numeric", month: "long",
});

const lead = filtered ? null : cards[0];
const rest = filtered ? cards : cards.slice(1);
---

<Base title="Știri — din presa Republicii Moldova">
  {filtered ? (
    <div class="page-head">
      <span class="kicker">{q ? "Căutare" : "Categorie"}</span>
      <h1>{q ? <>„{q}”</> : category}</h1>
      <p>{cards.length} {cards.length === 1 ? "știre" : "știri"} · <a class="clear" href="/">✕ resetează</a></p>
    </div>
  ) : (
    <div class="updated">Actualizat automat · {now}</div>
  )}

  {cards.length === 0 && (
    <p class="gol">Nicio știre {q ? "pentru această căutare" : category ? "în această categorie" : "disponibilă"}.</p>
  )}

  {lead && (
    <a class="lead" href={`/s/${lead.id}`}>
      <span class="kicker">{lead.category}</span>
      <h2 class="lead-title">{lead.canonical_title}</h2>
      <p class="lead-sum">{lead.lead}…</p>
      <div class="art-meta">
        <span class="art-left"><span class="theme">{lead.category}</span></span>
        <span class="surse-n">{formatSourceCount(lead.source_count)}</span>
      </div>
    </a>
  )}

  {rest.map((c) => (
    <a class="art" href={`/s/${c.id}`}>
      <h3 class="art-title">{c.canonical_title}</h3>
      <p class="art-sum">{c.lead}</p>
      <div class="art-meta">
        <span class="art-left"><span class="theme">{c.category}</span></span>
        <span class="surse-n">{formatSourceCount(c.source_count)}</span>
      </div>
    </a>
  ))}
</Base>
