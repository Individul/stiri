---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { topClusters } from "../lib/db";
import { formatSourceCount, rankScore } from "../lib/format";

const { DB } = env;
const category = Astro.url.searchParams.get("cat") ?? undefined;
const q = (Astro.url.searchParams.get("q") ?? "").trim() || undefined;

const cards = (await topClusters(DB, category, q))
  .sort((a, b) => rankScore(b.source_count, b.last_updated_at) - rankScore(a.source_count, a.last_updated_at))
  .slice(0, 50);
---

<Base title="Știri — agregate din surse românești">
  {(q || category) && (
    <p class="context">
      {q ? <>Rezultate pentru „{q}”</> : <>Categoria: {category}</>}
      <span class="count"> · {cards.length} știri</span>
      <a class="clear" href="/">✕ resetează</a>
    </p>
  )}

  {
    cards.length === 0 ? (
      <p class="empty">Nicio știre {q ? "pentru această căutare" : category ? "în această categorie" : "disponibilă"}.</p>
    ) : (
      <ul class="feed">
        {cards.map((c) => (
          <li class="card">
            <span class="cat">{c.category}</span>
            <a class="card-title" href={`/s/${c.id}`}>
              {c.canonical_title}
            </a>
            <p class="lead">{c.lead}…</p>
            <div class="meta">
              <span class="badge">{formatSourceCount(c.source_count)}</span>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <style>
    .context {
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0 0 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }
    .context .clear { margin-left: 0.6rem; text-decoration: none; }
    .context .count { color: var(--muted); }

    .feed { list-style: none; margin: 0; padding: 0; }
    .card {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border);
    }
    .cat + .card-title { margin-top: 0.25rem; }
    .card-title {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.3px;
      text-decoration: none;
      color: var(--fg);
    }
    .card-title:hover { color: var(--accent); }
    .lead {
      margin: 0.45rem 0 0.7rem;
      color: var(--muted);
      font-size: 0.96rem;
      line-height: 1.6;
    }
    .meta { display: flex; align-items: center; gap: 0.6rem; }
    .empty { color: var(--muted); }
  </style>
</Base>
