---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { topClusters, distinctCategories } from "../lib/db";
import { formatSourceCount, rankScore } from "../lib/format";

const { DB } = env;
const category = Astro.url.searchParams.get("cat") ?? undefined;

const cards = (await topClusters(DB, category))
  .sort((a, b) => rankScore(b.source_count, b.last_updated_at) - rankScore(a.source_count, a.last_updated_at))
  .slice(0, 50);

const cats = await distinctCategories(DB);
---

<Base title="Știri — agregate din surse românești">
  <nav class="cats" aria-label="Filtrează după categorie">
    <a href="/" class={category ? "" : "active"}>Toate</a>
    {
      cats.map((c) => (
        <a href={`/?cat=${encodeURIComponent(c)}`} class={c === category ? "active" : ""}>
          {c}
        </a>
      ))
    }
  </nav>

  {
    cards.length === 0 ? (
      <p class="empty">Nicio știre disponibilă{category ? " în această categorie" : ""}.</p>
    ) : (
      <ul class="feed">
        {cards.map((c) => (
          <li class="card">
            <span class="cat">{c.category}</span>
            <a class="card-title" href={`/s/${c.id}`}>
              {c.canonical_title}
            </a>
            <p class="lead">{c.lead}…</p>
            <div class="meta">
              <span class="badge">{formatSourceCount(c.source_count)}</span>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <style>
    .cats {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.35rem 1.1rem;
      padding-bottom: 1.25rem;
      margin-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .cats a {
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      text-decoration: none;
      color: var(--muted);
    }
    .cats a:hover { color: var(--fg); }
    .cats a.active { color: var(--accent); }

    .feed { list-style: none; margin: 0; padding: 0; }
    .card {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border);
    }
    .cat + .card-title { margin-top: 0.25rem; }
    .card-title {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 1.45rem;
      font-weight: 700;
      line-height: 1.22;
      text-decoration: none;
      color: var(--fg);
    }
    .card-title:hover { color: var(--accent); }
    .lead {
      margin: 0.45rem 0 0.7rem;
      color: var(--muted);
      font-size: 0.96rem;
      line-height: 1.6;
    }
    .meta { display: flex; align-items: center; gap: 0.6rem; }
    .empty { color: var(--muted); }
  </style>
</Base>
