---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { clusterById, clusterSources } from "../../lib/db";
import { formatSourceCount } from "../../lib/format";

const { DB } = env;

const id = Number(Astro.params.id);
const cluster = Number.isInteger(id) ? await clusterById(DB, id) : null;

if (!cluster) {
  return new Response("Știrea nu a fost găsită", { status: 404 });
}

const sources = await clusterSources(DB, id);

const paragraphs = cluster.summary_md
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter((p) => p.length > 0);

function parse(iso: string | null): Date | null {
  if (!iso) return null;
  const d = new Date(/[T]/.test(iso) ? iso : iso.replace(" ", "T") + "Z");
  return Number.isNaN(d.getTime()) ? null : d;
}
function fmtDate(iso: string | null): string {
  const d = parse(iso);
  return d ? d.toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" }) : "";
}
function fmtDateTime(iso: string | null): string {
  const d = parse(iso);
  if (!d) return "";
  const date = d.toLocaleDateString("ro-RO", { weekday: "long", day: "numeric", month: "long" });
  const time = d.toLocaleTimeString("ro-RO", { hour: "2-digit", minute: "2-digit" });
  return `${date} la ${time}`;
}
function relTime(iso: string | null): string {
  const d = parse(iso);
  if (!d) return "";
  const min = Math.max(0, Math.round((Date.now() - d.getTime()) / 60000));
  if (min < 1) return "acum câteva secunde";
  if (min < 60) return `acum ${min} ${min === 1 ? "minut" : "minute"}`;
  const h = Math.round(min / 60);
  if (h < 24) return `acum ${h} ${h === 1 ? "oră" : "ore"}`;
  const zile = Math.round(h / 24);
  return `acum ${zile} ${zile === 1 ? "zi" : "zile"}`;
}
---

<Base title={`${cluster.canonical_title} — Știri`} description={paragraphs[0]?.slice(0, 160)}>
  <article class="reader">
    <a class="reader-back" href="/">← Prima pagină</a>
    <span class="kicker">{cluster.category}</span>
    <h1 class="reader-title">{cluster.canonical_title}</h1>

    <div class="reader-meta">
      <span>{formatSourceCount(cluster.source_count)} · {relTime(cluster.last_updated_at)} · {fmtDateTime(cluster.last_updated_at)}</span>
      <span class="ai-tag">Sumar automat</span>
    </div>

    <div class="reader-body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {sources.length > 0 && (
      <section class="surse">
        <div class="sec-head"><h2>Sursele subiectului</h2></div>
        {sources.map((s) => (
          <a class="sursa" href={s.url} target="_blank" rel="noopener">
            <span class="sursa-title">{s.title}</span>
            <span class="sursa-meta">{s.source}{s.published_at && <> · {fmtDate(s.published_at)}</>}</span>
          </a>
        ))}
      </section>
    )}

    <p class="reader-legal">
      Rezumat generat automat de un sistem AI pe baza articolelor de la sursele de mai sus;
      articolele integrale aparțin în totalitate surselor originale.
    </p>
  </article>
</Base>
