---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { clusterById, clusterSources } from "../../lib/db";
import { formatSourceCount } from "../../lib/format";

const { DB } = env;

const id = Number(Astro.params.id);
const cluster = Number.isInteger(id) ? await clusterById(DB, id) : null;

if (!cluster) {
  return new Response("Știrea nu a fost găsită", { status: 404 });
}

const sources = await clusterSources(DB, id);

// summary_md: paragrafe separate prin linii goale.
const paragraphs = cluster.summary_md
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter((p) => p.length > 0);

function fmtDate(iso: string | null): string {
  if (!iso) return "";
  const normalized = /[T]/.test(iso) ? iso : iso.replace(" ", "T") + "Z";
  const d = new Date(normalized);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("ro-RO", { day: "numeric", month: "long", year: "numeric" });
}
---

<Base title={`${cluster.canonical_title} — Știri`} description={paragraphs[0]?.slice(0, 160)}>
  <a class="back" href="/">← Prima pagină</a>

  <article>
    <div class="hd">
      <span class="cat">{cluster.category}</span>
      <h1>{cluster.canonical_title}</h1>
    </div>

    <div class="meta-row">
      <span class="meta-info">
        {formatSourceCount(cluster.source_count)}
        {fmtDate(cluster.last_updated_at) && <> · {fmtDate(cluster.last_updated_at)}</>}
      </span>
      <span class="sumar">Sumar automat</span>
    </div>

    <div class="summary">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {
      sources.length > 0 && (
        <section class="sources">
          <h2 class="sources-h">Sursele subiectului</h2>
          <ul>
            {sources.map((s) => (
              <li>
                <a class="src-title" href={s.url} target="_blank" rel="noopener">{s.title}</a>
                <span class="src-meta">
                  {s.source}{s.published_at && <> · {fmtDate(s.published_at)}</>}
                </span>
              </li>
            ))}
          </ul>
          <p class="note">
            Rezumatul este generat automat de un sistem AI pe baza articolelor de la sursele
            de mai sus; articolele integrale aparțin în totalitate surselor originale.
          </p>
        </section>
      )
    }
  </article>

  <style>
    .back {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      text-decoration: none;
      margin-bottom: 1.5rem;
    }
    .back:hover { color: var(--accent); }

    .hd { text-align: center; }
    .hd .cat { display: block; margin-bottom: 0.5rem; }
    article h1 {
      font-family: var(--font-display);
      font-size: 2rem;
      line-height: 1.18;
      margin: 0 auto 0;
      max-width: 620px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 1.5rem 0;
      padding: 0.7rem 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .meta-info { font-size: 0.82rem; color: var(--muted); }
    .sumar {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      border: 1px solid var(--accent);
      border-radius: 999px;
      padding: 0.25rem 0.7rem;
      white-space: nowrap;
    }

    .summary p {
      font-family: var(--font-display);
      font-size: 1.08rem;
      line-height: 1.75;
      margin: 0 0 1.2rem;
    }

    .sources { margin-top: 2.75rem; }
    .sources-h {
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--fg);
      border-top: 2px solid var(--fg);
      padding-top: 0.6rem;
      margin: 0 0 0.25rem;
    }
    .sources ul { list-style: none; margin: 0; padding: 0; }
    .sources li {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1.25rem;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--border);
    }
    .src-title {
      color: var(--fg);
      text-decoration: none;
      font-size: 0.98rem;
      line-height: 1.4;
    }
    .src-title:hover { color: var(--accent); text-decoration: underline; }
    .src-meta {
      flex: none;
      text-align: right;
      font-size: 0.78rem;
      color: var(--muted);
      white-space: nowrap;
    }
    .note {
      margin-top: 1.5rem;
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.6;
    }
  </style>
</Base>
